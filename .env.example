POSTGRES_USER=preassess
POSTGRES_DB=preassess
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
SECRET_KEY=change-me-long-random
# Engine (ZAP + egress guard): random, 32+ chars each (openssl rand -hex 24). Worker and egress refuse change-me.
ZAP_API_KEY=change-me-zap-api-key
EGRESS_TOKEN=change-me-egress-token
# Credential encryption keypair (apps refuse to start while empty): docker-compose run --rm --no-deps worker python -m app.cli gen-credential-keys
# and paste both lines here. The api only gets the public key; only the worker gets the private key.
CREDENTIALS_PUBLIC_KEY=
# Back up CREDENTIALS_PRIVATE_KEY; changing it makes every saved test account unreadable.
CREDENTIALS_PRIVATE_KEY=
APP_ENV=dev
COOKIE_SECURE=false
# Laptop/dev template. For the org server: APP_ENV=prod, COOKIE_SECURE=true, put a TLS terminator in front;
# COOKIE_SECURE=true without TLS breaks sign-in because browsers drop the cookies.
# Login throttling trusts X-Forwarded-For from these peers. Safe at '*' because the api port is not published
# (only nginx can reach it); restrict it if you ever expose the api directly.
FORWARDED_ALLOW_IPS=*
