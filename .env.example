POSTGRES_USER=preassess
POSTGRES_DB=preassess
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
SECRET_KEY=change-me-long-random
APP_ENV=dev
COOKIE_SECURE=false
# Laptop/dev template. For the org server: APP_ENV=prod, COOKIE_SECURE=true, put a TLS terminator in front;
# COOKIE_SECURE=true without TLS breaks sign-in because browsers drop the cookies.
# Login throttling trusts X-Forwarded-For from these peers. Safe at '*' because the api port is not published
# (only nginx can reach it); restrict it if you ever expose the api directly.
FORWARDED_ALLOW_IPS=*
